<!doctype html>
{#- The project page, rendered once per language by tools/build_site.py.
    Text comes from site/i18n/<lang>.json as `t`; `root` leads back to the
    site root from the page, `shots` to its language's card screenshots. #}
<html lang="{{ lang.code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ t.meta.title }}</title>
<meta name="description" content="{{ t.meta.description }}">
<link rel="canonical" href="{{ lang.url }}">
{%- for other in languages %}
<link rel="alternate" hreflang="{{ other.code }}" href="{{ other.url }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ default_url }}">
<meta property="og:title" content="{{ t.meta.og_title }}">
<meta property="og:description" content="{{ t.meta.og_description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ lang.url }}">
<meta property="og:locale" content="{{ lang.locale }}">
{%- for other in languages if other.code != lang.code %}
<meta property="og:locale:alternate" content="{{ other.locale }}">
{%- endfor %}
<meta property="og:image" content="{{ og_image }}">
<meta name="theme-color" content="#dfe3de" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#141a18" media="(prefers-color-scheme: dark)">
<link rel="icon" href="{{ root }}assets/icon.svg" type="image/svg+xml">
<link rel="preload" href="{{ root }}assets/fonts/barlow-condensed-700-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ root }}assets/fonts/barlow-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ root }}assets/fonts/fonts.css">
<script type="application/ld+json">{{ json_ld }}</script>
{%- if lang.code == "en" %}
<script>
// A first visit with a browser set to one of the other languages goes to that
// page. A language picked in the menu wins, and so does arriving from one of
// this site's own pages, e.g. by choosing English there. Crawlers report en-US
// and stay here.
(function () {
  var pages = {{ languages | map(attribute="code") | list | tojson }};
  var aliases = { no: "nb", nn: "nb" };
  function go(code) { if (code !== "en" && pages.indexOf(code) >= 0) location.replace(code + "/" + location.hash); }
  try {
    if (document.referrer && new URL(document.referrer).href.indexOf(new URL(".", location.href).href) === 0) return;
    var chosen = localStorage.getItem("sbp-lang");
    if (chosen) return go(chosen);
  } catch (e) { /* no storage: fall through to the browser languages */ }
  var wanted = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ""];
  for (var i = 0; i < wanted.length; i++) {
    var code = String(wanted[i]).toLowerCase().split("-")[0];
    code = aliases[code] || code;
    if (pages.indexOf(code) >= 0) return go(code);
  }
})();
</script>
{%- endif %}
<style>
/* The 24-hour segment timer from the fuse box: 96 pins for 96 quarter hours, set in the colour of
   the pilot's action. Appliance-grey housing, a white dial face, Barlow lettering, and the signal-red
   pointer as the one loud thing. In the dark the timer is a lit display on a dark housing. */
:root {
  --housing: #dfe3de;
  --face: #f8f9f6;
  --ink: #1c2421;
  --ink-2: #4b5751;
  --rule: #c2cac4;
  --rim: #b8c0ba;
  --ring: #e4e8e4;
  --pointer: #d2261c;
  --k-charge: #1d8549;
  --k-cover: #e08a12;
  --k-hold: #6652cf;
  --k-export: #2e4a56;
  --k-auto: #ffffff;
  --e-charge: #0f5a31;
  --e-cover: #9c5d08;
  --e-hold: #43349a;
  --e-export: #172a31;
  --e-auto: #8f9a94;
  --ray-auto: #b3bdb7;
  --btn: #1c2421;
  --on-btn: #f8f9f6;
  --press: #000000;
  --foot: #1c2421;
  --on-foot: #dfe3de;
  --display: "Barlow Condensed", "Arial Narrow", sans-serif;
  --body: "Barlow", "Segoe UI", system-ui, sans-serif;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root {
    --housing: #141a18;
    --face: #1d2522;
    --ink: #e6ece9;
    --ink-2: #a9b5af;
    --rule: #34403b;
    --rim: #3d4944;
    --ring: #27312d;
    --pointer: #ff5a4a;
    --k-charge: #2fa865;
    --k-cover: #f0a234;
    --k-hold: #8d7cf2;
    --k-export: #c3d2d8;
    --k-auto: #2a3430;
    --e-charge: #7fd9a6;
    --e-cover: #ffd08a;
    --e-hold: #c4baff;
    --e-export: #ffffff;
    --e-auto: #66746e;
    --ray-auto: #4a5852;
    --btn: #e6ece9;
    --on-btn: #141a18;
    --press: #66746e;
    --foot: #0c100f;
    --on-foot: #c9d3ce;
    color-scheme: dark;
  }
}
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
body { margin: 0; background: var(--housing); color: var(--ink); font-family: var(--body); font-size: 17px; line-height: 1.55; hyphens: auto; -webkit-hyphens: auto; hyphenate-limit-chars: 8 4 4; overflow-wrap: break-word; }
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; text-underline-offset: 3px; text-decoration-thickness: 1px; }
:focus-visible { outline: 2.5px solid var(--pointer); outline-offset: 3px; border-radius: 3px; }
.wrap { max-width: 1240px; margin: 0 auto; padding-inline: max(16px, env(safe-area-inset-left)) max(16px, env(safe-area-inset-right)); }
@media (min-width: 700px) { .wrap { padding-inline: 32px; } }
h1, h2, h3 { font-family: var(--display); font-weight: 700; margin: 0; text-wrap: balance; overflow-wrap: anywhere; }
p { margin: 0; }
.num { font-family: var(--display); font-weight: 600; font-variant-numeric: tabular-nums lining-nums; }

/* nav */
nav.top { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; padding-block: 18px; }
.brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--display); font-weight: 600; font-size: 21px; }
.brand img { width: 30px; height: 30px; }
.links { display: flex; flex-wrap: wrap; justify-content: flex-end; margin-left: auto; align-items: center; gap: 4px 22px; font-size: 16px; font-weight: 500; }
.links > a:not(.btn) { text-decoration: none; color: var(--ink-2); padding-block: 8px; }
.links > a:not(.btn):hover { color: var(--ink); text-decoration: underline; }
/* The menu hangs from the nav's right edge, wherever the toggle wrapped to. */
.lang { font-size: 16px; }
.lang summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; padding: 7px 10px; border: 1.5px solid var(--rule); border-radius: 4px; color: var(--ink-2); background: var(--face); }
.lang summary::-webkit-details-marker { display: none; }
.lang summary::after { content: ""; width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); }
.lang[open] summary { color: var(--ink); border-color: var(--ink-2); }
.lang ul { position: absolute; z-index: 5; right: 0; top: calc(100% - 8px); margin: 0; padding: 6px; list-style: none; min-width: 11rem; background: var(--face); border: 1.5px solid var(--rule); border-radius: 4px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14); }
.lang li a { display: block; padding: 6px 10px; border-radius: 3px; text-decoration: none; }
.lang li a:hover, .lang li a[aria-current] { background: var(--housing); }
/* Below desktop width the section links give way to docs, language and GitHub. */
@media (max-width: 1099px) { .links > a[href^="#"] { display: none; } }
.btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 10px 20px; border-radius: 4px; font-weight: 600; text-decoration: none; border: 2px solid var(--btn); }
.btn-solid { background: var(--btn); color: var(--on-btn); box-shadow: 0 3px 0 var(--press); }
.btn-solid:hover { transform: translateY(1px); box-shadow: 0 2px 0 var(--press); }
.btn-line { color: var(--ink); background: var(--face); }
.btn-line:hover { border-color: var(--ink-2); }
.links .btn { min-height: 40px; padding: 6px 16px; }

/* hero: the copy, and the timer beside it */
.hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px 56px; align-items: center; padding-block: 16px 40px; }
@media (min-width: 980px) { .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); } }
.hero-copy { display: flex; flex-direction: column; gap: 22px; }
.hero h1 { font-size: clamp(44px, 6.4vw, 88px); line-height: 0.95; }
.hero-copy > p { font-size: 19px; color: var(--ink-2); max-width: 32em; }
.ctas { display: flex; flex-wrap: wrap; gap: 12px; }
.facts { display: flex; flex-wrap: wrap; gap: 6px 10px; margin: 0; padding: 0; list-style: none; font-size: 15px; font-weight: 500; }
.facts li { padding: 3px 10px; border: 1.5px solid var(--rule); border-radius: 3px; background: var(--face); }

.timer { margin: 0; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.dial-box { position: relative; width: 100%; max-width: 600px; margin-inline: auto; aspect-ratio: 1; }
.dial { width: 100%; height: 100%; display: block; touch-action: pan-y; cursor: crosshair; }
.dial:focus-visible { outline-offset: -6px; border-radius: 50%; }
.dial .rim { fill: var(--face); stroke: var(--rim); stroke-width: 2; }
.dial .rim-in { fill: none; stroke: var(--rule); stroke-width: 1.5; }
.dial .hub { fill: var(--housing); stroke: var(--rim); stroke-width: 1.5; }
.dial .ring { fill: none; stroke: var(--ring); stroke-width: 1; }
.dial text { font-family: var(--display); font-weight: 600; font-size: 19px; fill: var(--ink); text-anchor: middle; dominant-baseline: central; }
.dial text.minor { font-size: 14px; fill: var(--ink-2); font-weight: 500; }
.dial text.scale { font-size: 12px; fill: var(--ink-2); font-weight: 500; text-anchor: start; }
.dial .pin { stroke-width: 1.4; fill: var(--k); stroke: var(--e); transform: translateY(7px); }
.dial .pin.k-a { transform: none; }
.dial .ray { stroke: var(--k); stroke-width: 4.6; }
.dial .ray.k-a { stroke: var(--ray-auto); }
.dial.reading .ray { opacity: 0.35; }
.dial.reading .ray.on { opacity: 1; }
.dial .hand { stroke: var(--pointer); stroke-width: 5; stroke-linecap: round; }
.dial .hand-tip { fill: var(--pointer); }
.dial .hand-g { transform-origin: 300px 300px; transition: transform 0.18s ease-out; }
@media (prefers-reduced-motion: no-preference) {
  /* One moment on load: the pilot sets the pins, around the clock from midnight. */
  .dial .pin:not(.k-a) { animation: set-pin 0.3s cubic-bezier(0.3, 1.6, 0.5, 1) calc(250ms + var(--i) * 14ms) backwards; }
}
@media (prefers-reduced-motion: reduce) { .dial .hand-g { transition: none; } }
@keyframes set-pin { from { fill: var(--k-auto); stroke: var(--e-auto); transform: none; } }
.k-a { --k: var(--k-auto); --e: var(--e-auto); }
.k-c { --k: var(--k-charge); --e: var(--e-charge); }
.k-o { --k: var(--k-cover); --e: var(--e-cover); }
.k-h { --k: var(--k-hold); --e: var(--e-hold); }
.k-e { --k: var(--k-export); --e: var(--e-export); }
.k-p { --k: var(--k-charge); --e: var(--e-charge); }

.readout { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 30%; text-align: center; display: flex; flex-direction: column; align-items: center; pointer-events: none; font-size: clamp(11px, 1.6vw, 15px); line-height: 1.25; color: var(--ink-2); }
.readout .time { font-family: var(--display); font-weight: 600; font-size: clamp(14px, 2.4vw, 22px); color: var(--ink); font-variant-numeric: tabular-nums; }
.readout .price { font-family: var(--display); font-weight: 700; font-size: clamp(28px, 5.4vw, 54px); line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
.readout .act { margin-top: 4px; font-weight: 600; color: var(--ink); }

.timer figcaption { display: flex; flex-direction: column; gap: 2px; max-width: 40em; }
.timer figcaption strong { font-family: var(--display); font-size: 22px; line-height: 1.2; }
.timer figcaption span { color: var(--ink-2); font-size: 15.5px; }
.legend, .key { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 0; padding: 0; list-style: none; font-size: 15px; color: var(--ink-2); }
.legend li, .key li { display: inline-flex; align-items: center; gap: 8px; }
.sw { width: 10px; height: 18px; border-radius: 2px; border: 1.4px solid var(--e); background: var(--k); flex: 0 0 auto; }
.sw.k-p { background: repeating-linear-gradient(135deg, var(--k-charge) 0 3px, var(--face) 3px 5px); }

.sum { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px 40px; align-items: baseline; padding: 22px 0; border-block: 2px solid var(--ink); }
@media (min-width: 900px) { .sum { grid-template-columns: auto minmax(0, 1fr); } }
.sum .num { font-size: clamp(26px, 3.6vw, 40px); line-height: 1.1; }
.sum .num b { font-weight: 600; color: var(--k-charge); }
.sum > p:last-child { color: var(--ink-2); max-width: 44em; }

/* sections */
.sec { padding-block: 80px 0; display: flex; flex-direction: column; gap: 32px; }
.lede { display: flex; flex-direction: column; gap: 12px; max-width: 42em; }
.lede h2 { font-size: clamp(36px, 4.6vw, 56px); line-height: 1; }
.lede p { color: var(--ink-2); font-size: 18px; }

/* seasons: one small timer each */
.seasons { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); gap: 32px 40px; }
.seasons li { display: flex; flex-direction: column; gap: 10px; }
.mini { width: 168px; height: 168px; }
.mini .face { fill: var(--face); stroke: var(--rim); stroke-width: 1.5; }
.mini .seg { fill: var(--k); stroke: var(--housing); stroke-width: 2; }
.mini .seg.k-a { stroke: var(--e-auto); stroke-width: 1.2; }
.mini .seg.k-p { fill: url(#hatch); }
.hatch-bg { fill: var(--face); }
.hatch-fg { fill: var(--k-charge); }
.mini text { font-family: var(--display); font-weight: 600; font-size: 15px; fill: var(--ink-2); text-anchor: middle; dominant-baseline: central; }
.seasons h3 { font-size: 30px; line-height: 1.05; }
.seasons p { color: var(--ink-2); }

/* the card viewer: one screenshot at a time, picked with push buttons */
.viewer { background: var(--face); border: 2px solid var(--ink); border-radius: 6px; padding: 16px; display: flex; flex-direction: column; gap: 18px; }
@media (min-width: 700px) { .viewer { padding: 24px; } }
.views { display: none; margin: 0; padding: 0; list-style: none; flex-wrap: wrap; gap: 10px 8px; }
.js .views { display: flex; }
.views button { font: inherit; font-family: var(--display); font-weight: 600; font-size: 18px; min-height: 44px; padding: 6px 16px; border: 2px solid var(--ink); border-radius: 4px; background: var(--face); color: var(--ink); cursor: pointer; box-shadow: 0 3px 0 var(--ink); }
.views button[aria-pressed="true"] { background: var(--ink); color: var(--face); transform: translateY(2px); box-shadow: 0 1px 0 var(--ink); }
.shots { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
.js .shots .shot:not(.on) { display: none; }
.shot { margin: 0; display: flex; flex-direction: column; gap: 10px; }
.shot picture { max-width: 880px; border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; }
.shot figcaption { color: var(--ink-2); font-size: 15.5px; max-width: 46em; }
.shot figcaption b { color: var(--ink); }

/* six steps, in the order the pilot runs them */
.route { margin: 0; padding: 0; list-style: none; counter-reset: stop; display: grid; grid-template-columns: minmax(0, 1fr); }
.route li { counter-increment: stop; position: relative; padding: 0 0 26px 52px; display: flex; flex-direction: column; gap: 4px; }
.route li::before { content: counter(stop); position: absolute; left: 0; top: -2px; width: 34px; height: 34px; border-radius: 50%; border: 2px solid var(--ink); background: var(--face); display: grid; place-items: center; font-family: var(--display); font-weight: 700; font-size: 18px; z-index: 1; }
.route li::after { content: ""; position: absolute; left: 16px; top: 32px; bottom: 0; width: 2px; background: var(--ink); }
.route li:last-child::after { display: none; }
.route strong { font-family: var(--display); font-weight: 700; font-size: 22px; line-height: 1.15; padding-top: 2px; }
.route span { color: var(--ink-2); font-size: 16px; }
@media (min-width: 1040px) {
  .route { grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: 24px; }
  .route li { padding: 50px 0 0; }
  .route li::before { top: 0; }
  .route li::after { left: 34px; right: -24px; top: 16px; bottom: auto; width: auto; height: 2px; }
}

/* features */
.feat { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px 56px; }
@media (min-width: 960px) { .feat { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); } }
.feat ul { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr)); column-gap: 40px; border-top: 2px solid var(--ink); }
.feat li { display: flex; flex-direction: column; gap: 3px; padding: 16px 0 18px; border-bottom: 1.5px solid var(--rule); }
.feat li strong { font-size: 17px; font-weight: 600; }
.feat li span { color: var(--ink-2); font-size: 16px; }
.sources { margin: 8px 0 0; display: grid; grid-template-columns: minmax(0, 1fr); border-top: 2px solid var(--ink); }
.sources div { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px 24px; padding: 14px 0; border-bottom: 1.5px solid var(--rule); }
@media (min-width: 700px) { .sources div { grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); } }
.sources dt { font-weight: 600; }
.sources dd { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 22px; color: var(--ink-2); }
.sources-note { margin: 12px 0 0; color: var(--ink-2); font-size: 16px; }

/* install */
.install { margin-top: 88px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px 56px; padding-top: 32px; border-top: 2px solid var(--ink); }
@media (min-width: 960px) { .install { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); } }
.install .lede { align-self: start; }
.install .lede .btn { align-self: flex-start; margin-top: 8px; }
.install ol { margin: 0; padding: 0; list-style: none; counter-reset: st; display: flex; flex-direction: column; gap: 12px; }
.install li { counter-increment: st; display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 12px; padding: 16px; background: var(--face); border: 1.5px solid var(--rule); border-radius: 4px; }
.install li::before { content: counter(st); font-family: var(--display); font-weight: 700; font-size: 38px; line-height: 1; color: var(--pointer); }
.install li p + p { margin-top: 4px; color: var(--ink-2); font-size: 16px; }

footer.foot { margin-top: 72px; background: var(--foot); color: var(--on-foot); }
footer.foot .wrap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 32px; padding-block: 26px 40px; font-size: 15px; }
footer.foot nav { display: flex; flex-wrap: wrap; gap: 6px 22px; }
</style>
</head>
<body>

<div class="wrap">
<nav class="top" aria-label="{{ t.nav.main_label }}">
<a class="brand" href="#top"><img src="{{ root }}assets/icon.svg" alt="" width="30" height="30"><span>Smart Battery Pilot</span></a>
<div class="links">
<a href="#plans">{{ t.nav.plans }}</a>
<a href="#card">{{ t.nav.card }}</a>
<a href="#features">{{ t.nav.features }}</a>
<a href="#install">{{ t.nav.install }}</a>
<a href="{{ root }}docs/" hreflang="en">{{ t.nav.docs }}</a>
<details class="lang">
<summary>{{ lang.name }}</summary>
<ul aria-label="{{ t.nav.language_label }}">
{%- for other in languages %}
<li><a href="{{ (root ~ other.path) or './' }}" lang="{{ other.code }}" hreflang="{{ other.code }}"{% if other.code == lang.code %} aria-current="page"{% endif %}>{{ other.name }}</a></li>
{%- endfor %}
</ul>
</details>
<a class="btn btn-solid" href="https://github.com/cygnusb/ha-smart-battery-pilot">GitHub</a>
</div>
</nav>
</div>

<main>
{%- set start = 78 %}
{%- set hhmm = "%02d:%02d" %}
<header id="top" class="wrap">
<div class="hero">
<div class="hero-copy">
<h1>{{ t.hero.title }}</h1>
<p>{{ t.hero.lede }}</p>
<div class="ctas">
<a class="btn btn-solid" href="#install">{{ t.hero.cta_install }}</a>
<a class="btn btn-line" href="{{ root }}docs/optimizer/" hreflang="en">{{ t.hero.cta_planner }}</a>
</div>
<ul class="facts">
{%- for key in ["free", "local", "home_assistant", "safe"] %}
<li>{{ t.hero.facts[key] }}</li>
{%- endfor %}
</ul>
</div>

<figure class="timer">
<div class="dial-box">
<svg class="dial" id="dial" viewBox="0 0 600 600" tabindex="0" role="img" aria-label="{{ t.board.chart_label }}">
<defs><pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect class="hatch-bg" width="6" height="6"></rect><rect class="hatch-fg" width="3" height="6"></rect></pattern></defs>
<circle class="rim" cx="300" cy="300" r="294"></circle>
<circle class="rim-in" cx="300" cy="300" r="244"></circle>
{%- for ring in dial.rings %}
<circle class="ring" cx="300" cy="300" r="{{ ring.r }}"></circle>
{%- endfor %}
{%- for ring in dial.rings if ring.v in [0.2, 0.4] %}
<text class="scale" x="305" y="{{ 300 - ring.r - 7 }}">{{ ring.v | price }}</text>
{%- endfor %}
<g id="rays">
{%- for ray in dial.rays %}{% set bar = bars[loop.index0] %}
<line class="ray k-{{ bar.k }}" x1="{{ ray.x1 }}" y1="{{ ray.y1 }}" x2="{{ ray.x2 }}" y2="{{ ray.y2 }}" data-k="{{ bar.k }}" data-p="{{ bar.p | price }}"></line>
{%- endfor %}
</g>
{%- for n in dial.numerals %}
<text{% if not n.major %} class="minor"{% endif %} x="{{ n.x }}" y="{{ n.y }}">{{ n.h }}</text>
{%- endfor %}
{%- for angle in dial.pins %}{% set bar = bars[loop.index0] %}
<g transform="rotate({{ angle }} 300 300)"><rect class="pin k-{{ bar.k }}" style="--i:{{ loop.index0 }}" x="295.4" y="16" width="9.2" height="26" rx="2"></rect></g>
{%- endfor %}
<circle class="hub" cx="300" cy="300" r="96"></circle>
<g class="hand-g" id="hand" style="transform: rotate({{ (start + 0.5) * 3.75 }}deg)"><line class="hand" x1="300" y1="202" x2="300" y2="60"></line><path class="hand-tip" d="M291 64 L300 46 L309 64 Z"></path></g>
</svg>
<p class="readout" id="readout" aria-live="polite"><span class="time">{{ hhmm | format(start // 4, start % 4 * 15) }}–{{ hhmm | format((start + 1) // 4, (start + 1) % 4 * 15) }}</span><span class="price">{{ bars[start].p | price }}</span><span>EUR/kWh</span><span class="act">{{ t.actions[bars[start].k] }}</span></p>
</div>
<figcaption><strong>{{ t.board.title }}</strong><span>{{ t.board.subtitle }} {{ t.board.hint }}</span></figcaption>
<ul class="legend">
{%- for k in ["c", "o", "h", "a"] %}
<li><i class="sw k-{{ k }}"></i><span data-act="{{ k }}">{{ t.actions[k] }}</span></li>
{%- endfor %}
</ul>
</figure>
</div>

<div class="sum">
<p class="num" aria-hidden="true">{{ 0.10 | price }} ÷ {{ 0.9 | price }} + {{ 0.10 | price }} = <b>{{ 0.21 | price }}</b> &lt; {{ 0.50 | price }}</p>
<p>{{ t.board.sum }}</p>
</div>
</header>

<section id="plans" class="wrap sec">
<div class="lede">
<h2>{{ t.plans.title }}</h2>
<p>{{ t.plans.lede }}</p>
</div>
<ul class="seasons">
{%- for key, strip in strips %}
<li>
<svg class="mini" viewBox="0 0 200 200" aria-hidden="true"><circle class="face" cx="100" cy="100" r="97"></circle>{% for seg in minis[key] %}<path class="seg k-{{ seg.k }}" d="{{ seg.d }}"></path>{% endfor %}<text x="100" y="56">0</text><text x="144" y="100">6</text><text x="100" y="144">12</text><text x="56" y="100">18</text></svg>
<h3>{{ t.plans.seasons[key].title }}</h3>
<p>{{ t.plans.seasons[key].text }}</p>
</li>
{%- endfor %}
</ul>
<ul class="key">
{%- for k in ["c", "p", "o", "h", "e", "a"] %}
<li><i class="sw k-{{ k }}"></i>{{ t.actions[k] }}</li>
{%- endfor %}
</ul>
</section>

<section id="card" class="wrap sec">
<div class="lede">
<h2>{{ t.card.title }}</h2>
<p>{{ t.card.lede }}</p>
</div>
<div class="viewer">
<ul class="views" aria-label="{{ t.card.views_label }}">
{%- for shot in screenshots %}
<li><button type="button" aria-pressed="{{ 'true' if loop.first else 'false' }}" aria-controls="shot-{{ shot.name }}">{{ t.card.shots[shot.name].title }}</button></li>
{%- endfor %}
</ul>
<div class="shots">
{%- for shot in screenshots %}
<figure class="shot{% if loop.first %} on{% endif %}" id="shot-{{ shot.name }}"><picture><source media="(prefers-color-scheme: dark)" srcset="{{ shots }}card_{{ shot.name }}_dark.png"><img src="{{ shots }}card_{{ shot.name }}_light.png" alt="{{ t.card.shots[shot.name].alt }}" width="1232" height="{{ shot.height }}"{% if not loop.first %} loading="lazy"{% endif %}></picture><figcaption><b>{{ t.card.shots[shot.name].title }}.</b> {{ t.card.shots[shot.name].caption }}</figcaption></figure>
{%- endfor %}
</div>
</div>
</section>

<section class="wrap sec">
<div class="lede">
<h2>{{ t.steps.title }}</h2>
<p>{{ t.steps.lede }}</p>
</div>
<ol class="route">
{%- for key in ["price", "consumption", "pv", "optimisation", "execution", "accounting"] %}
<li><strong>{{ t.steps["items"][key].title }}</strong><span>{{ t.steps["items"][key].text }}</span></li>
{%- endfor %}
</ol>
</section>

<section id="features" class="wrap sec">
<div class="feat">
<div class="lede">
<h2>{{ t.features.title }}</h2>
<p>{{ t.features.lede }}</p>
</div>
<ul>
{%- for key in ["consumption", "pv", "car", "reserve", "cold", "numbers", "safe", "languages"] %}
<li><strong>{{ t.features["items"][key].title }}</strong><span>{{ t.features["items"][key].text }}</span></li>
{%- endfor %}
</ul>
</div>
<dl class="sources">
<div><dt>{{ t.features.prices_from }}</dt><dd><span>Nordpool</span><span>Tibber</span><span>aWATTar</span><span>EPEX Spot</span><span>ENTSO-E</span></dd></div>
<div><dt>{{ t.features.batteries_via }}</dt><dd><span>Fronius</span><span>Victron</span><span>SMA</span><span>Sungrow</span><span>E3DC</span><span>Zendure</span><span>{{ t.features.any_inverter }}</span></dd></div>
</dl>
<p class="sources-note">{{ t.features.bridges }} <a href="{{ root }}docs/price-bridges/" hreflang="en">{{ t.features.bridges_link }}</a></p>
</section>

<div class="wrap">
<section id="install" class="install">
<div class="lede">
<h2>{{ t.install.title }}</h2>
<p>{{ t.install.lede }}</p>
<a class="btn btn-solid" href="https://my.home-assistant.io/redirect/marketplace_repository/?owner=cygnusb&amp;repository=ha-smart-battery-pilot&amp;category=integration">{{ t.install.open }}</a>
</div>
<ol>
<li><div><p>{{ t.install.download }}</p></div></li>
<li><div><p>{{ t.install.scripts }}</p><p>{{ t.install.scripts_detail }} <a href="{{ root }}docs/getting-started/" hreflang="en">{{ t.install.scripts_link }}</a></p></div></li>
<li><div><p>{{ t.install.add }}</p><p>{{ t.install.add_detail }}</p></div></li>
<li><div><p>{{ t.install.card }}</p><p>{{ t.install.card_detail }}</p></div></li>
</ol>
</section>
</div>
</main>

<footer class="foot">
<div class="wrap">
<span>{{ t.footer.text }}</span>
<nav aria-label="{{ t.footer.nav_label }}"><a href="{{ root }}docs/" hreflang="en">{{ t.nav.docs }}</a><a href="{{ root }}docs/troubleshooting/" hreflang="en">{{ t.footer.faq }}</a><a href="{{ root }}docs/changelog/" hreflang="en">{{ t.footer.changelog }}</a><a href="https://github.com/cygnusb/ha-smart-battery-pilot/issues">{{ t.footer.issues }}</a><a href="https://github.com/cygnusb/ha-smart-battery-pilot">GitHub</a></nav>
</div>
</footer>

<script>
(function () {
  document.documentElement.classList.add("js");

  // The language picked in the menu, for the next visit to the English page.
  document.querySelectorAll(".lang a[hreflang]").forEach(function (a) {
    a.addEventListener("click", function () {
      try { localStorage.setItem("sbp-lang", a.getAttribute("hreflang")); } catch (e) { /* not remembered */ }
    });
  });

  // Card viewer: one screenshot at a time, chosen with the buttons.
  var buttons = document.querySelectorAll(".views button");
  buttons.forEach(function (b) {
    b.addEventListener("click", function () {
      buttons.forEach(function (o) { o.setAttribute("aria-pressed", o === b ? "true" : "false"); });
      document.querySelectorAll(".shot").forEach(function (s) { s.classList.toggle("on", s.id === b.getAttribute("aria-controls")); });
    });
  });

  // The dial: point at a pin (or use the arrow keys) to turn the pointer to its slot and read it.
  var dial = document.getElementById("dial");
  var hand = document.getElementById("hand");
  var out = document.getElementById("readout");
  var rays = document.querySelectorAll("#rays line");
  var names = {};
  document.querySelectorAll(".legend [data-act]").forEach(function (n) { names[n.getAttribute("data-act")] = n.textContent; });
  var cur = {{ start }};
  function pad(n) { return (n < 10 ? "0" : "") + n; }
  function hhmm(q) { return pad(Math.floor(q / 4) % 24) + ":" + pad((q % 4) * 15); }
  function show(q) {
    rays[cur].classList.remove("on");
    cur = q;
    var r = rays[q], k = r.getAttribute("data-k");
    r.classList.add("on");
    dial.classList.add("reading");
    hand.style.transform = "rotate(" + ((q + 0.5) * 3.75) + "deg)";
    out.innerHTML = '<span class="time">' + hhmm(q) + "–" + hhmm(q + 1) + '</span><span class="price">' + r.getAttribute("data-p") +
      '</span><span>EUR/kWh</span><span class="act">' + names[k] + "</span>";
  }
  function at(e) {
    var b = dial.getBoundingClientRect();
    var x = e.clientX - b.left - b.width / 2, y = e.clientY - b.top - b.height / 2;
    var turn = (Math.atan2(x, -y) / (2 * Math.PI) + 1) % 1;
    return Math.min(95, Math.floor(turn * 96));
  }
  dial.addEventListener("pointermove", function (e) { var q = at(e); if (q !== cur || !dial.classList.contains("reading")) show(q); });
  dial.addEventListener("pointerdown", function (e) { show(at(e)); });
  dial.addEventListener("pointerleave", function (e) { if (e.pointerType === "mouse") dial.classList.remove("reading"); });
  dial.addEventListener("keydown", function (e) {
    var d = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
    if (d === undefined) return;
    e.preventDefault();
    show((cur + d + 96) % 96);
  });
  dial.addEventListener("blur", function () { dial.classList.remove("reading"); });
})();
</script>
</body>
</html>
